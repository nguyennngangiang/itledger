# Copy to deploy/vps/.env — docker compose reads it automatically for the file in
# this directory. Gitignored (the repo's .gitignore excludes .env everywhere).

# Required. The LAN deployment hard-codes `poop` in be/docker-compose.yml; that
# does not travel to a public host.
POSTGRES_PASSWORD=CHANGE_ME

# Optional, defaults shown.
POSTGRES_USER=postgres
POSTGRES_DB=itledger

# The origin the browser will use. Only reaches the API's CORS list — the SPA and
# /api share one origin behind Caddy, so nothing exercises it in normal use.
PUBLIC_ORIGIN=https://itledger.example.com
