# Copy to deploy/vps/.env — docker compose reads it automatically for the file in
# this directory. Gitignored (the repo's .gitignore excludes .env everywhere).

# Required. The LAN deployment hard-codes `poop` in be/docker-compose.yml; that
# does not travel to a public host.
POSTGRES_PASSWORD=CHANGE_ME

# Optional, defaults shown.
POSTGRES_USER=postgres
POSTGRES_DB=itledger

# The origin the browser will use. Only reaches the API's CORS list — the SPA and
# /api share one origin behind Caddy, so nothing exercises it in normal use.
PUBLIC_ORIGIN=https://itledger.example.com

# There is no login. ADMIN_USERNAME / ADMIN_PASSWORD / SECRET_KEY were removed
# on 2026-11-04 along with be/auth.py. The API is reachable by anyone who can
# reach this host's web proxy — keep it off the public internet, or put the
# login back before publishing it.

# ---- cổng xuất dữ liệu TẠM THỜI (be/routers/export.py) --------------------
# Để hệ thống mới tự kéo toàn bộ sổ sang: GET /api/export/data
#     curl -H "Authorization: Bearer $EXPORT_TOKEN" https://<host>/api/export/data
#
# Cả hai biến đều PHẢI có, nếu không endpoint trả 404 như thể không tồn tại.
# Token < 32 ký tự cũng bị từ chối. Sinh token:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# EXPORT_TOKEN_UNTIL là NGÀY CUỐI còn dùng được (YYYY-MM-DD). Đặt ngắn thôi —
# đây là lớp bảo vệ duy nhất của 258 hồ sơ nhân sự trên một ứng dụng không còn
# đăng nhập. Xong việc thì xoá cả hai biến rồi dựng lại api.
# EXPORT_TOKEN=
# EXPORT_TOKEN_UNTIL=
