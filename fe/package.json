{
  "name": "fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,ai -c cyan,magenta \"npm:dev:vite\" \"npm:dev:ai\"",
    "dev:vite": "vite",
    "dev:ai": "powershell -ExecutionPolicy Bypass -File ../ai/run-host.ps1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-placeholders.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "animejs": "^3.2.2",
    "antd": "^6.5.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "exceljs": "^4.4.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "react-toastify": "^11.1.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/animejs": "^3.1.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
