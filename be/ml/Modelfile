# Ollama Modelfile — load your fine-tuned adapter on top of qwen2.5:7b.
# After converting the LoRA adapter to GGUF (see README.md), from be/ml/ run:
#   ollama create itledger-qwen -f Modelfile
# Then point the app at it:  OLLAMA_MODEL=itledger-qwen

FROM qwen2.5:7b

# The GGUF LoRA adapter produced from be/ml/adapter (see README.md step 4).
ADAPTER ./adapter.gguf

PARAMETER temperature 0.2

SYSTEM """You rank and explain IT-device search results for the IT Ledger app,
tuned on the team's own "correct match" feedback."""
