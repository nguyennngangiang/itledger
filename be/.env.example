# Copy to .env and adjust. Read by db.py via the DATABASE_URL env var.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itledger

# Master switch for everything that reaches a model. OFF, and that is the deployed
# state: the LLM stack at D:\LLM was retired because it pinned ~6 GB of RAM and 88%
# of the GPU's VRAM to serve one button. Everything below is inert while this is 0.
#
# What is off: Ask AI (its router is not even mounted — see be/main.py), LLM rerank
# on the /semantic-search endpoints, and file extraction/OCR, which is what limits
# handover import to Excel files matching the company template.
AI_ENABLED=0

# Internal-network OpenAI-compatible LLM used by be/llm.py (Ask AI, explain,
# rerank). Caddy-fronted server on :8443, base path /v1. Auth is a Bearer token
# (LLM_API_KEY) — a secret, keep it only in be/.env (gitignored). On the server the
# key lived in D:\LLM\API_KEY.txt. LLM_MODEL options: llama3.1:8b (text, default) |
# qwen2.5vl:7b (text + image reading). Full API reference: be/LLM_API.md.
# Omit these entirely while AI_ENABLED=0 — a dead key is worth nothing on disk.
LLM_BASE_URL=http://192.168.3.252:8443/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=llama3.1:8b
# File-extraction endpoint on the same server (not under /v1). Uploaded files go
# here (xlsx/docx/pdf parsed; scanned PDF/images OCR'd via vision).
RAG_EXTRACT_URL=http://192.168.3.252:8443/rag/extract

# The local e5-small embedder (ai/main.py) behind the three /semantic-search
# endpoints. Not started by deploy/start-itledger.ps1 any more: nothing but Ask AI
# ever called those endpoints. Set this and run ai/run-host.ps1 to bring it back.
AI_URL=http://192.168.3.252:8010
