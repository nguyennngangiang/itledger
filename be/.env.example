# Copy to .env and adjust. Read by db.py via the DATABASE_URL env var.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itledger

# Master switch for the chat LLM (be/llm.py). OFF here (this file describes the
# LAN/dev workflow) — the D:\LLM stack it originally pointed at was retired.
# The VPS deployment (deploy/vps/docker-compose.vps.yml) runs its own local
# Ollama instead and sets this to 1; see that file for the real values.
#
# What is off while this is 0: LLM rerank on the /semantic-search endpoints,
# and the handover importer's model fallback for off-template files (the plain
# Excel template still parses fine either way). File extraction (be/extract.py)
# and embeddings (be/embeddings.py, EMBED_* below) do NOT depend on this flag.
AI_ENABLED=0

# Internal-network OpenAI-compatible LLM used by be/llm.py (Ask AI, explain,
# rerank). Caddy-fronted server on :8443, base path /v1. Auth is a Bearer token
# (LLM_API_KEY) — a secret, keep it only in be/.env (gitignored). On the server the
# key lived in D:\LLM\API_KEY.txt. LLM_MODEL options: llama3.1:8b (text, default) |
# qwen2.5vl:7b (text + image reading). Full API reference: be/LLM_API.md.
# Omit these entirely while AI_ENABLED=0 — a dead key is worth nothing on disk.
LLM_BASE_URL=http://192.168.3.252:8443/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=llama3.1:8b
# RAG_EXTRACT_URL is no longer read: be/extract.py parses xlsx/docx/native-PDF
# locally now (openpyxl/python-docx/pymupdf), independent of AI_ENABLED. Only
# OCR of scanned PDFs/images still has no reader — that needs a vision model
# this doesn't run.

# Local embedding model — be/embeddings.py, used by document RAG
# (be/routers/documents.py) AND the three /semantic-search endpoints + the Ask
# AI fleet tools (be/search.py) — independent of AI_ENABLED, see be/embeddings.py.
# Point at a local Ollama (`ollama pull bge-m3`) to try any of this outside the
# VPS. Replaces the old local e5-small embedder (ai/main.py) — that service and
# AI_URL are gone; nothing reads them any more.
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# There is no login. ADMIN_USERNAME / ADMIN_PASSWORD / SECRET_KEY were removed
# on 2026-11-04 along with be/auth.py — setting them here does nothing now.

# Scan screen (be/scan.py): Claude reads paperwork through `claude -p` on the
# host (deploy/vps/claude-runner.py), reached over this unix socket. No API key.
# Without the runner only in-browser barcode scanning works.
CLAUDE_RUNNER_SOCKET=/run/itledger-claude/claude.sock
SCAN_MODEL=claude-opus-5-5

# ---- cổng xuất dữ liệu TẠM THỜI (be/routers/export.py) --------------------
# Để hệ thống mới tự kéo toàn bộ sổ sang: GET /api/export/data
#     curl -H "Authorization: Bearer $EXPORT_TOKEN" https://<host>/api/export/data
#
# Cả hai biến đều PHẢI có, nếu không endpoint trả 404 như thể không tồn tại.
# Token < 32 ký tự cũng bị từ chối. Sinh token:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# EXPORT_TOKEN_UNTIL là NGÀY CUỐI còn dùng được (YYYY-MM-DD). Đặt ngắn thôi —
# đây là lớp bảo vệ duy nhất của 258 hồ sơ nhân sự trên một ứng dụng không còn
# đăng nhập. Xong việc thì xoá cả hai biến rồi dựng lại api.
# EXPORT_TOKEN=
# EXPORT_TOKEN_UNTIL=
