# Copy to .env and adjust. Read by db.py via the DATABASE_URL env var.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itledger

# Internal-network OpenAI-compatible LLM used by be/llm.py (Ask AI, explain,
# rerank). Caddy-fronted server on :8443, base path /v1. Auth is a Bearer token
# (LLM_API_KEY) — a secret, keep it only in be/.env (gitignored). On the server the
# key lives in D:\LLM\API_KEY.txt. LLM_MODEL options: llama3.1:8b (text, default) |
# qwen2.5vl:7b (text + image reading). Full API reference: be/LLM_API.md.
LLM_BASE_URL=http://192.168.3.252:8443/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=llama3.1:8b
